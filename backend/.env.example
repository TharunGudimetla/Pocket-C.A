# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/pocket-ca
# Use "memory" for a zero-setup local demo, or "mongo" for MongoDB persistence.
STORAGE_DRIVER=memory

# JWT
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# AI Provider
# Paste your Google AI Studio / Gemini key into GEMINI_API_KEY.
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
